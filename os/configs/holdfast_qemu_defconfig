# HoldFast Vault userland on QEMU's generic arm64 machine, for boot tests.
# Same root filesystem, tool and no-network kernel options as the Pi image;
# only the board support differs.
BR2_aarch64=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_BACKUP_SITE=""
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="holdfast-vault"
BR2_TARGET_GENERIC_ISSUE="HoldFast Vault"
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HOLDFAST_PATH)/board/holdfast/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HOLDFAST_PATH)/board/holdfast/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOLDFAST_NODE=y
BR2_PACKAGE_HOLDFAST_VAULT=y
BR2_ROOTFS_POST_SCRIPT_ARGS="ttyAMA0"
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HOLDFAST_PATH)/board/holdfast/linux-no-network.fragment"
