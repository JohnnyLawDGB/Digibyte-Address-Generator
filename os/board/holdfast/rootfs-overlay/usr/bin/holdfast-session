#!/bin/sh
# The only thing a HoldFast Vault console can run. There is no login and no
# shell: this menu is started directly by init and restarted if it exits.

APP=/opt/holdfast/dgb-coldprep.cjs
trap '' INT QUIT TSTP HUP

pause() {
	printf '\nPress Enter to return to the menu… '
	read -r _
}

while :; do
	clear
	cat <<'BANNER'

  HoldFast Vault
  Air-gapped cold storage. This device has no network hardware enabled,
  runs entirely from memory, and forgets everything when powered off.

    1) New seed: 24 words
    2) New seed: 24 words + passphrase ("24+1")
    3) Recovery drill (check a written backup)
    4) Check an address
    5) Self-test
    6) Power off

BANNER
	printf '  Choose 1-6: '
	read -r choice || exit 0
	clear
	case "$choice" in
	1) node "$APP" --require-dice --no-kit --no-passphrase || pause ;;
	2) node "$APP" --require-dice --no-kit --require-passphrase || pause ;;
	3) node "$APP" verify || pause ;;
	4)
		printf 'Address: '
		read -r addr
		node "$APP" check-address "$addr"
		pause
		;;
	5)
		node "$APP" selftest
		pause
		;;
	6)
		clear
		echo 'Powering off. Remove power once the screen goes blank.'
		poweroff -f
		sleep 30
		;;
	*) continue ;;
	esac
done
